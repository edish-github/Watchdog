# Watchdog — copy to .env.local. Unset optional keys fall back safely.
# Local default: file:.data/watchdog.db (created automatically). Production: libsql://<db>-<org>.turso.io
DATABASE_URL=file:.data/watchdog.db
DATABASE_AUTH_TOKEN=
# 32+ random characters; required in production (signs the sandbox cookie)
SESSION_SECRET=
DEMO_MODE=true
SANDBOX_TTL_DAYS=7
# B2+: NEXT_PUBLIC_BACKEND=local|remote
NEXT_PUBLIC_BACKEND=local

# AI drafting (B4). One key is enough; without any, drafts use the built-in template.
# The label on every draft is the model the provider's API reports.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# anthropic | gemini — only needed when both keys are set
LLM_PROVIDER=
LLM_EFFORT=low
LLM_TIMEOUT_MS=12000

# Scheduled jobs (B5): /api/cron/{retention,weather,cycle,outbox} require "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=
# FHIR delivery from the server: HTTPS allow-list (the public HAPI R4 sandbox is always allowed).
FHIR_DEFAULT_ENDPOINT=https://hapi.fhir.org/baseR4
FHIR_ALLOWED_ENDPOINTS=

# FHIR canonical base (B6): your deployed https://<domain>/fhir — the app serves its CodeSystems there.
NEXT_PUBLIC_FHIR_CANONICAL=
# Extra browser connect-src origins for the CSP, space-separated (e.g. a custom FHIR server used in local mode).
NEXT_PUBLIC_CSP_CONNECT=
